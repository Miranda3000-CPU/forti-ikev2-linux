#!/usr/bin/env bash
# CLI Rápido para FortiClient VPN (strongSwan / swanctl)
# Totalmente baseado em IP Privado

set -e

GREEN="\033[1;32m"
RED="\033[1;31m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
CYAN="\033[1;36m"
RESET="\033[0m"

CHILD_NAME="forticlient"
GATEWAY="198.51.100.100"
WEB_URL="https://10.64.10.1:6464/login?redir=%2F"

get_vip() {
    sudo swanctl --list-sas 2>/dev/null | grep -v "agent plugin" | sed -n -E 's/.*local +([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)\/32.*/\1/p' | head -n 1
}

check_status() {
    if sudo swanctl --list-sas 2>/dev/null | grep -q "ESTABLISHED"; then
        return 0
    else
        return 1
    fi
}

show_status() {
    local vip
    vip=$(get_vip)
    echo -e "${CYAN}====================================================${RESET}"
    echo -e "${CYAN}             STATUS DA VPN FORTICLIENT              ${RESET}"
    echo -e "${CYAN}====================================================${RESET}"
    echo -e " Gateway Remoto (Privado) : ${YELLOW}${GATEWAY}${RESET}"
    echo -e " Origem Local             : ${YELLOW}203.0.113.7${RESET}"
    echo -e " IP Virtual (DHCP Forti)  : ${YELLOW}${vip:-"Não atribuído"}${RESET}"
    echo -n " Estado Atual             : "
    if check_status; then
        echo -e "${GREEN}● CONECTADO E ATIVO${RESET}"
        echo ""
        echo -e "${BLUE}Detalhes da Conexão (SA):${RESET}"
        sudo swanctl --list-sas 2>&1 | grep -v "agent plugin" | grep -v "plugin 'agent'" || true
    else
        echo -e "${RED}○ DESCONECTADO${RESET}"
    fi
    echo -e "${CYAN}====================================================${RESET}"
}

do_connect() {
    echo -e "${BLUE}[*] Recarregando configurações swanctl...${RESET}"
    sudo swanctl --load-all >/dev/null 2>&1 || true

    echo -e "${BLUE}[*] Conectando à VPN FortiGate Gateway Privado (${GATEWAY})...${RESET}"
    output=$(sudo swanctl --initiate --child "$CHILD_NAME" 2>&1 | grep -v "agent plugin" | grep -v "plugin 'agent'" || true)
    echo "$output"

    if check_status; then
        local vip
        vip=$(get_vip)
        echo -e "\n${GREEN}[✓] VPN CONECTADA COM SUCESSO!${RESET}"
        echo -e "${GREEN}[✓] IP Virtual atribuído dinamicamente: ${vip}${RESET}"
    else
        echo -e "\n${RED}[✗] Não foi possível estabelecer o túnel.${RESET}"
    fi
}

do_disconnect() {
    echo -e "${YELLOW}[*] Encerrando túnel VPN...${RESET}"
    sudo swanctl --terminate --ike "$CHILD_NAME" 2>/dev/null || sudo swanctl --terminate --child "$CHILD_NAME" 2>/dev/null || true
    echo -e "${GREEN}[✓] VPN Desconectada.${RESET}"
}

do_test() {
    echo -e "${CYAN}[*] Testando conectividade interna da VPN...${RESET}"
    if check_status; then
        local vip
        vip=$(get_vip)
        echo -e "${GREEN}[✓] Túnel ativo no kernel (VIP: ${vip}).${RESET}"
        echo -e "[*] Testando acesso ao painel web FortiOS (${WEB_URL})..."
        http_code=$(curl -k -s -o /dev/null -w "%{http_code}" --connect-timeout 5 "$WEB_URL" || true)
        if [ "$http_code" = "200" ]; then
            echo -e "${GREEN}[✓] SUCESSO TOTAL! Painel FortiOS respondeu com HTTP 200 OK!${RESET}"
        elif [ -n "$http_code" ]; then
            echo -e "${YELLOW}[!] Servidor respondeu com código HTTP ${http_code}.${RESET}"
        else
            echo -e "${RED}[✗] Falha ao contatar painel web na porta 6464.${RESET}"
        fi
    else
        echo -e "${RED}[✗] VPN não está conectada. Conecte primeiro com: vpn connect${RESET}"
    fi
}

do_logs() {
    echo -e "${CYAN}[*] Exibindo logs do daemon de VPN (Ctrl+C para sair)...${RESET}"
    sudo journalctl -u strongswan.service -f
}

case "${1:-}" in
    connect|up|start)
        do_connect
        ;;
    disconnect|down|stop)
        do_disconnect
        ;;
    status)
        show_status
        ;;
    test|ping)
        do_test
        ;;
    logs)
        do_logs
        ;;
    gui)
        vpn-gui &
        ;;
    *)
        echo -e "${CYAN}Gerenciador FortiClient VPN${RESET}"
        echo -e "Uso: ${YELLOW}vpn${RESET} [comando]"
        echo ""
        echo "Comandos disponíveis:"
        echo -e "  ${GREEN}vpn connect${RESET}     - Conectar à VPN"
        echo -e "  ${RED}vpn disconnect${RESET}  - Desconectar da VPN"
        echo -e "  ${BLUE}vpn status${RESET}      - Ver estado da conexão e IP virtual"
        echo -e "  ${CYAN}vpn test${RESET}        - Testar acesso web interno (10.64.10.1:6464)"
        echo -e "  ${YELLOW}vpn logs${RESET}        - Visualizar logs em tempo real"
        echo -e "  ${GREEN}vpn gui${RESET}         - Abrir Interface Gráfica"
        echo ""
        show_status
        ;;
esac
